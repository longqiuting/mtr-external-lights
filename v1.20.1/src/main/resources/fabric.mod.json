{
  "schemaVersion": 1,
  "id": "mtrlte",
  "version": "${version}",
  "name": "LTE (LTY's transit expansion)",
  "description": "Adds dynamic head and tail lights to Minecraft Transit Railway trains, plus a Xiamen-style objects creative tab with its own platform screen door blocks (models reuse MTR's PSD geometry, textures come from the Xiamen Metro line 1 pack). Install it on the server as well and train collisions damage, launch and kill you server-side (with a custom death message); without it on the server the mod keeps working client-side only.",
  "authors": [
    "厦航在拍车的无名机长 (kigurumiLTY)"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "mixins": [
    "mtrlte.ante.mixins.json",
    "mtrlte.collision.mixins.json",
    "mtrlte.fangsu.mixins.json",
    "mtrlte.nte.mixins.json",
    "mtrlte.rain.mixins.json",
    "mtrlte.mtr.mixins.json",
    "mtrlte.mtrserver.mixins.json",
    "mtrlte.beamlight.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "dev.js.mtrheadlight.server.LteServer",
      "dev.js.mtrheadlight.VehicleLightsJsonServer"
    ],
    "client": [
      "dev.js.mtrheadlight.MtrHeadlightClient",
      "dev.js.mtrheadlight.collision.CollisionBootstrap",
      "dev.js.mtrheadlight.mtr.BuiltInTrainsInit",
      "dev.js.mtrheadlight.VehicleLightsJsonClient",
      "dev.js.mtrheadlight.signal.SignalLinkClient",
      "dev.js.mtrheadlight.xiamen.XiamenClient"
    ],
    "lambdynlights:initializer": [
      "dev.js.mtrheadlight.MtrHeadlightDynamicLights"
    ],
    "modmenu": [
      "dev.js.mtrheadlight.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "mtr": "*"
  },
  "recommends": {
    "lambdynlights": ">=4.4.0",
    "lambdynlights_api": ">=4.4.0"
  }
}
